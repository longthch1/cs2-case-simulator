[Unit]
Description=CS2 Case Opening Simulator Backend Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/cs2-case-simulator
Environment="PATH=/var/www/cs2-case-simulator/venv/bin:/usr/bin"
Environment="ENVIRONMENT=production"
ExecStart=/var/www/cs2-case-simulator/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5
StandardOutput=append:/var/log/cs2-simulator/service.log
StandardError=append:/var/log/cs2-simulator/error.log

[Install]
WantedBy=multi-user.target
